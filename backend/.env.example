# ===========================
# Mentor IA — Backend
# Plantilla de variables de entorno
# Copia este archivo como `.env` y rellena los valores reales.
# NO commitear `.env` real.
# ===========================

# --- OpenAI (LLM chat + OCR multimodal + embeddings) ---
# Obtener en https://platform.openai.com/api-keys
# 100% del stack IA va por OpenAI tras agotar cuota free de Gemini
# tanto en LLM como en embeddings. Ver CLAUDE.md §2.5.
OPENAI_API_KEY=

# --- Qdrant Cloud ---
# Crear cluster en https://cloud.qdrant.io/
QDRANT_URL=https://xxxxxxxx.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=mentor_ia_aprendizaje

# --- Make.com ---
# Crear escenario con Custom Webhook y copiar la URL aquí
MAKE_WEBHOOK_URL=

# --- Storage local ---
BASE_DOCS_DIR=./data/ejemplos

# --- CORS ---
# Lista separada por comas
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://mentor-ia-sistema.vercel.app

# --- Modelos OpenAI (defaults; cambiar solo con justificación) ---
# LLM chat + OCR multimodal:
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Embeddings: text-embedding-3-large recortado a 768 dims vía parámetro
# `dimensions` (MRL nativo). El servicio renormaliza a norma unitaria
# antes de upsertear en Qdrant (la colección usa distancia COSINE).
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=768
EMBEDDING_DIM=768

# --- Chunking (defaults) ---
CHUNK_MAX_CHARS=900
CHUNK_OVERLAP=150
CHUNK_MAX=100

# --- RAG (defaults) ---
RAG_SCORE_THRESHOLD=0.55
RAG_TOP_K=5

# --- Rate limiting (defaults; formato slowapi "N/minute") ---
# Protege los endpoints que consumen créditos OpenAI frente a abuso.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERY=20/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_PLAN=5/minute
RATE_LIMIT_OCR=10/minute

# --- OCR de PDF escaneado ---
# Máx. de páginas que se envían a OpenAI Vision por documento. Evita que
# un único PDF dispare cientos de llamadas multimodales.
OCR_PDF_MAX_PAGES=20

# --- Límites de tamaño de archivo (bytes) ---
MAX_IMAGE_BYTES=10485760
MAX_PDF_BYTES=26214400
MAX_TEXT_BYTES=5242880

# --- max_tokens OpenAI (acota coste por respuesta) ---
OPENAI_MAX_TOKENS_CHAT=800
OPENAI_MAX_TOKENS_OCR=2000
OPENAI_MAX_TOKENS_PLAN=1400
