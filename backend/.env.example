# ===========================
# Mentor IA — Backend
# Plantilla de variables de entorno
# Copia este archivo como `.env` y rellena los valores reales.
# NO commitear `.env` real.
# ===========================

# --- Google Gemini ---
# Obtener en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Qdrant Cloud ---
# Crear cluster en https://cloud.qdrant.io/
QDRANT_URL=https://xxxxxxxx.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=mentor_ia_aprendizaje

# --- Make.com ---
# Crear escenario con Custom Webhook y copiar la URL aquí
MAKE_WEBHOOK_URL=

# --- Storage local ---
BASE_DOCS_DIR=./data/ejemplos

# --- CORS ---
# Lista separada por comas
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://mentor-ia-sistema.vercel.app

# --- Modelos (defaults; cambiar solo con justificación) ---
# gemini-embedding-001 es el reemplazo GA de text-embedding-004 (deprecado 14-ene-2026).
# Devuelve 3072 dims por defecto; se trunca a 768 con outputDimensionality (MRL).
# Tras truncar, los vectores NO quedan normalizados — services/gemini.py debe renormalizar
# antes de upsertear en Qdrant (la colección usa distancia COSINE).
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_OUTPUT_DIMENSIONALITY=768
LLM_MODEL=gemini-flash-latest
EMBEDDING_DIM=768

# --- Chunking (defaults) ---
CHUNK_MAX_CHARS=900
CHUNK_OVERLAP=150
CHUNK_MAX=100

# --- RAG (defaults) ---
RAG_SCORE_THRESHOLD=0.55
RAG_TOP_K=5
